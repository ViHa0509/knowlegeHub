{
 "id": "kh-default",
 "version": 1,
 "description": "KH default secret and PII masks (all mask mode)",
 "patterns": [
  {
   "name": "private_key",
   "kind": "secret",
   "mode": "mask",
   "regex": "-----BEGIN [A-Z ]{0,40}PRIVATE KEY-----[\\s\\S]{1,16000}?-----END [A-Z ]{0,40}PRIVATE KEY-----",
   "description": "PEM private key block"
  },
  {
   "name": "url_credentials",
   "kind": "secret",
   "mode": "mask",
   "regex": "\\b[A-Za-z][A-Za-z0-9+.-]{1,20}://[^\\s:/@]{1,256}:[^\\s/@]{1,256}@",
   "description": "user:password in a URL"
  },
  {
   "name": "jwt",
   "kind": "secret",
   "mode": "mask",
   "regex": "\\beyJ[A-Za-z0-9_-]{8,8192}\\.[A-Za-z0-9_-]{8,8192}(?:\\.[A-Za-z0-9_-]{8,8192})?",
   "description": "JSON Web Token"
  },
  {
   "name": "bearer",
   "kind": "secret",
   "mode": "mask",
   "regex": "(?i)\\bbearer\\s{1,8}[A-Za-z0-9._~+/=-]{20,4096}",
   "description": "bearer credential"
  },
  {
   "name": "assigned_secret",
   "kind": "secret",
   "mode": "mask",
   "regex": "(?i)\\b(?:password|passwd|secret|token|api[_-]?key)\\s{0,8}[:=]\\s{0,8}(?=[^\\s]{0,255}\\d)[^\\s]{8,256}",
   "description": "password/secret/token/api key assigned a value of 8+ non-space characters with a digit"
  },
  {
   "name": "key_token",
   "kind": "secret",
   "mode": "mask",
   "regex": "\\b(?:sk|pk|ghp|gho|xoxb|xoxp)[-_][A-Za-z0-9_-]{16,1024}",
   "description": "API key shapes (sk-, pk-, ghp_, gho_, xoxb-, xoxp-)"
  },
  {
   "name": "aws_access_key",
   "kind": "secret",
   "mode": "mask",
   "regex": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b",
   "description": "AWS access key id"
  },
  {
   "name": "email",
   "kind": "pii",
   "mode": "mask",
   "regex": "\\b[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,253}\\.[A-Za-z]{2,24}\\b",
   "description": "e-mail address"
  },
  {
   "name": "phone",
   "kind": "pii",
   "mode": "mask",
   "regex": "\\+\\d{1,3}[ .-]?\\(?\\d{1,4}\\)?[ .-]?\\d{2,4}[ .-]?\\d{2,4}(?:[ .-]?\\d{2,4})?\\b",
   "description": "international phone number (+cc ...)"
  },
  {
   "name": "iban",
   "kind": "pii",
   "mode": "mask",
   "regex": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]){11,30}\\b",
   "description": "IBAN"
  },
  {
   "name": "high_entropy",
   "kind": "secret",
   "mode": "mask",
   "regex": "\\b(?=[0-9]*+[A-Za-z][A-Za-z]*+[0-9][0-9]*+[A-Za-z])[A-Za-z0-9]{24,}\\b",
   "min_entropy": 4.0,
   "description": "long random-looking token (24+ alphanumerics, letter-digit-letter, entropy >= 4.0 bits/char)"
  }
 ],
 "vectors": [
  {
   "text": "Contact jane.doe@example.com for access.",
